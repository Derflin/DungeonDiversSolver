[sub_resource type="Resource" id="Resource_yueo7"]
script = ExtResource("2_y8bum")
block_type = 2
content_text = "- [u]Distance[/u] from the [u]potential placement[/u] to any of the [u]related rooms[/u] is calculated by measuring the distance not from each room center, but from the farthest corners of the paired rooms for which the distance is calculated.
- After all the [u]distances[/u] are calculated from the [u]potential placement[/u] to all [u]related rooms[/u], the one with [u]highiest value[/u] is used to represent the given [u]potential placement[/u]."
metadata/_custom_type_script = "uid://dj8l0dr06uue7"

